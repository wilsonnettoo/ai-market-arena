# Copie para .env e preencha. O .env esta no .gitignore e NUNCA deve ser commitado:
# este repositorio e publico desde o primeiro commit (ver docs/DECISOES.md D3).
#
# Use EXCLUSIVAMENTE credenciais de PAPER TRADING. Nenhuma chave de conta real
# deve estar acessivel ao sistema em momento algum.

ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Feed de dados: iex ou sip. Qual a conta gratuita acessa e com qual defasagem
# e uma questao aberta registrada em docs/DECISOES.md D16, a ser preenchida na
# execucao do M2 (Task 12).
ALPACA_FEED=iex
